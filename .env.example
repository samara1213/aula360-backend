# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000
# Saltos de proxy inverso de confianza (0 si no hay proxy; 1 detrás de un balanceador).
TRUST_PROXY=0

# Supabase Postgres (desarrollo) por el pooler en modo sesión (la conexión directa es solo IPv6). Contraseña codificada para URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password-url-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true
# CA de Supabase en PEM (saltos de línea escritos como \n). Obligatorio en producción.
DB_SSL_CA=
# E2E (obligatorio): "shared" usa DATABASE_URL sin TRUNCATE (cada prueba borra solo lo que crea).
# "isolated" usa DATABASE_URL_TEST (otra BD, distinta de DATABASE_URL) y permite TRUNCATE.
E2E_DB_MODE=shared
DATABASE_URL_TEST=

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=<cadena-aleatoria-de-64+-caracteres>
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_TTL_DAYS=7

# SUPER_ADMIN inicial (lo usa yarn seed). Completar antes de ejecutar el seed y
# vaciar SEED_SUPERADMIN_PASSWORD después (sobre todo en entornos desplegados).
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_DOCUMENT_TYPE=CC
SEED_SUPERADMIN_DOCUMENT_NUMBER=
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_SUPERADMIN_PASSWORD=

# Correo (vacío en desarrollo = el correo solo se registra en el log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Supabase Storage (fase 6)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
